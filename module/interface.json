{
  "schema_version": "2.0",
  "limits": {
    "max_request_bytes": 65536,
    "max_response_bytes": 65536,
    "max_event_bytes": 65536,
    "max_outstanding_requests": 16
  },
  "control": [],
  "imports": [
    {
      "id": "tsuki.cloudredirect.status",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.status/1/request",
      "response": "ronin://host/tsuki.cloudredirect.status/1/response",
      "idempotency": "read-only",
      "effects": [
        "none"
      ]
    },
    {
      "id": "tsuki.cloudredirect.auth.begin",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.auth.begin/1/request",
      "response": "ronin://host/tsuki.cloudredirect.auth.begin/1/response",
      "idempotency": "non-repeatable",
      "effects": [
        "network"
      ]
    },
    {
      "id": "tsuki.cloudredirect.auth.poll",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.auth.poll/1/request",
      "response": "ronin://host/tsuki.cloudredirect.auth.poll/1/response",
      "idempotency": "read-only",
      "effects": [
        "none"
      ]
    },
    {
      "id": "tsuki.cloudredirect.auth.signout",
      "version": "1",
      "required": true,
