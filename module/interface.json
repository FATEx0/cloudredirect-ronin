        "secret",
        "module-config"
      ]
    },
    {
      "id": "tsuki.cloudredirect.apps.list",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.apps.list/1/request",
      "response": "ronin://host/tsuki.cloudredirect.apps.list/1/response",
      "idempotency": "read-only",
      "effects": [
        "none"
      ]
    },
    {
      "id": "tsuki.cloudredirect.remote.list",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.remote.list/1/request",
      "response": "ronin://host/tsuki.cloudredirect.remote.list/1/response",
      "idempotency": "read-only",
      "effects": [
        "network"
      ]
    },
    {
      "id": "tsuki.cloudredirect.sync.begin",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.sync.begin/1/request",
      "response": "ronin://host/tsuki.cloudredirect.sync.begin/1/response",
      "idempotency": "non-repeatable",
      "effects": [
        "network"
      ]
    },
    {
      "id": "tsuki.cloudredirect.sync.status",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.sync.status/1/request",
      "response": "ronin://host/tsuki.cloudredirect.sync.status/1/response",
      "idempotency": "read-only",
      "effects": [
        "none"
      ]
    },
    {
      "id": "tsuki.cloudredirect.manual.candidates",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.manual.candidates/1/request",
      "response": "ronin://host/tsuki.cloudredirect.manual.candidates/1/response",
      "idempotency": "read-only",
      "effects": ["none"]
    },
    {
      "id": "tsuki.cloudredirect.manual.configure",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.cloudredirect.manual.configure/1/request",
      "response": "ronin://host/tsuki.cloudredirect.manual.configure/1/response",
      "idempotency": "idempotency-keyed",
      "effects": ["module-config"]
    },
    {
      "id": "tsuki.desktop.url.open",
      "version": "1",
      "required": true,
      "execution": "immediate",
      "request": "ronin://host/tsuki.desktop.url.open/1/request",
      "response": "ronin://host/tsuki.desktop.url.open/1/response",
      "idempotency": "non-repeatable",
      "effects": [
        "process"
      ]
    }
  ],
  "event_imports": [],
  "exports": [],
  "events": [],
  "logging": {
    "sources": [
      {
        "kind": "line-file",
        "path": "$MODULE_LOG/cloud_redirect.log",
        "format": "bracket-level-lines",
        "max_line_bytes": 65536
      }
    ]
  },
  "health": {
    "aggregate": "all-required",
    "components": [
      {
        "component": "cloud-hook",
        "required": true,
        "readiness": {
          "kind": "runtime-evidence",
          "evidence": {
            "carrier": "runtime-file",
            "producer": "cloud-hook",
            "max_bytes": 4096,
            "freshness_ms": 30000,
            "compatibility_subject": "none"
          }
        }
      }
    ],
    "features": []
  },
  "private_resources": []
}
